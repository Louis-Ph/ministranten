{
  "deployment": {
    "publicBaseUrl": "https://ministranten-wett.vercel.app"
  },
  "monitoring": {
    "request": {
      "timeoutMs": 15000,
      "attempts": 3,
      "retryDelayMs": 3000,
      "maxResponseBytes": 1048576
    },
    "checks": {
      "website": {
        "path": "/",
        "format": "html",
        "contains": ["<title>Minis Wettstetten</title>", "id=\"app\""]
      },
      "database": {
        "path": "/api/health",
        "format": "json",
        "expected": {
          "ok": true,
          "configured": true,
          "schema": "ready",
          "root": "ready"
        }
      },
      "authentication": {
        "path": "/api/config",
        "format": "json",
        "expected": {
          "configured": true,
          "auth": {
            "supabaseReachable": true
          }
        }
      }
    }
  }
}

{
  "name": "api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "api",
  "sourceRoot": "api",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p api/tsconfig.build.json"
      },
      "outputs": ["{workspaceRoot}/dist/api"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vercel dev"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p tsconfig.json --noEmit",
        "cwd": "api"
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No lint configured'"
      }
    }
  },
  "tags": ["type:lib", "scope:api"]
}
